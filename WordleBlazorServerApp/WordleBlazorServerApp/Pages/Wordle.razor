@page "/wordle"

@inject IGameEngine gameEngine;

<MudField Typo="Typo.h3">
    Play Wordle
</MudField>

<table class="game-grid">
    @for(int guessIndex = 0; guessIndex < GameEngine.NUMBER_OF_ALLLOWED_GUESSES; guessIndex++)
    {
        <tr>
            @for(int letterIndex = 0; letterIndex < GameEngine.WORDLE_LENGTH; letterIndex++)
            {
                int rowIndex = guessIndex;
                int colIndex = letterIndex;

                <td>
                    <MudTextField T="string"
                                  @ref="InputFields[rowIndex, colIndex]"
                                  Value="@gameGrid.Guesses[rowIndex, colIndex]"
                                  ValueChanged="(value) => OnTextEntryAsync(value, rowIndex, colIndex)"
                                  OnKeyDown="(e) => HandleKeyDownAsync(e, rowIndex, colIndex)"
                                  Variant="Variant.Outlined"
                                  Disabled="GetIsFieldDisabled(rowIndex, colIndex)"
                                  ReadOnly="GetIsFieldDisabled(rowIndex, colIndex)"
                                  MaxLength="1"
                                  Class="guess_letter_entry"
                                  Style="@GetTextStyle(rowIndex, colIndex)"
                                  Immediate="true" />
                </td>
            }
        </tr>
    }
</table>

<table class="game-results">
    <tr>
        <td class="enter_guess_column">
            <MudButton @onclick="EnterGuessAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="GetIsGameComplete()">
                Enter
            </MudButton>
        </td>
        <td> 
            <MudButton @onclick="NewGameAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                New Game
            </MudButton>
        </td>
    </tr>
</table>

@if (gameState != null && gameState.GuessResult != null)
{
    <MudText Class="game_result_message">@gameState.GuessResult.ResultMessage</MudText>
}

<ErrorMessage ErrorMessages="errorMessages" />